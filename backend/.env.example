# Project
PROJECT_NAME="Jaipuria University Knowledge Assistant"
DEFAULT_UNIVERSITY_ID=jaipuria
DEFAULT_UNIVERSITY_NAME="Jaipuria Institute of Management / University"

# Security
SECRET_KEY=jaipuria-super-secret-jwt-key-change-in-prod-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Use SQLite for instant zero-dependency local dev, or PostgreSQL + pgvector:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/jaipuria_db
DATABASE_URL=sqlite:///./data/jaipuria_assistant.db

# LLM Configuration
# Options: 'ollama', 'gemini', 'openai'
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest

# Cloud LLM keys (optional fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embeddings
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# Document storage
STORAGE_DIR=./data/documents
POLICIES_SOURCE_DIR=..
